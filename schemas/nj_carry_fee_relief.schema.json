{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_checked_at",
    "last_verified_at",
    "state_municipality_count",
    "state_count_source_url",
    "statutory_application_fee",
    "statutory_municipal_portion",
    "statutory_state_portion",
    "statute_source_url",
    "verification_policy",
    "municipalities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "last_checked_at": {
      "type": "string",
      "format": "date"
    },
    "last_verified_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "state_municipality_count": {
      "const": 564
    },
    "state_count_source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/\\s]+"
    },
    "statutory_application_fee": {
      "const": 200
    },
    "statutory_municipal_portion": {
      "const": 150
    },
    "statutory_state_portion": {
      "const": 50
    },
    "statute_source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/\\s]+"
    },
    "verification_policy": {
      "type": "string"
    },
    "municipalities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "municipality",
          "county",
          "eligibility_summary",
          "application_instructions",
          "notes",
          "municipality_type",
          "municipality_code",
          "status",
          "relief_type",
          "statutory_municipal_portion",
          "refund_amount",
          "net_municipal_cost",
          "effective_date",
          "retroactive_date",
          "official_source_url",
          "secondary_source_url",
          "source_type",
          "verified_at",
          "last_checked_at",
          "evidence"
        ],
        "properties": {
          "municipality": {
            "type": "string",
            "minLength": 1
          },
          "county": {
            "type": "string",
            "minLength": 1
          },
          "eligibility_summary": {
            "type": "string",
            "minLength": 1
          },
          "application_instructions": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "municipality_type": {
            "enum": [
              "Borough",
              "Township",
              "Town",
              "City",
              "Village"
            ]
          },
          "municipality_code": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "status": {
            "enum": [
              "verified_full_or_substantial",
              "verified_partial",
              "announced_pending_documents",
              "under_consideration",
              "inactive_or_repealed"
            ]
          },
          "relief_type": {
            "enum": [
              "reported_refund",
              "refund",
              "reduction",
              "proposed_refund",
              "none"
            ]
          },
          "statutory_municipal_portion": {
            "const": 150
          },
          "refund_amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 150
          },
          "net_municipal_cost": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 150
          },
          "effective_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "retroactive_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "official_source_url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/\\s]+"
              },
              {
                "type": "null"
              }
            ]
          },
          "secondary_source_url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/\\s]+"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_type": {
            "enum": [
              "advocacy_reporting",
              "official_resolution",
              "official_minutes",
              "official_police",
              "official_agenda",
              "official_notice",
              "secondary_reporting",
              "social_media"
            ]
          },
          "verified_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_checked_at": {
            "type": "string",
            "format": "date"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "source_type",
                "source_date",
                "supporting_text",
                "verified_at"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://[^/\\s]+"
                },
                "source_type": {
                  "enum": [
                    "advocacy_reporting",
                    "official_resolution",
                    "official_minutes",
                    "official_police",
                    "official_agenda",
                    "official_notice",
                    "secondary_reporting",
                    "social_media"
                  ]
                },
                "source_date": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "supporting_text": {
                  "type": "string",
                  "minLength": 10
                },
                "verified_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
